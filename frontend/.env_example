# ─────────────────────────────────────────────────────────────────────────────
# EventSphere Management — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Only VITE_* variables are exposed to the browser bundle.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API & Socket ──────────────────────────────────────────────────────────────

# Base origin of the Express backend (no trailing slash, no /api path)
# In development this is proxied by Vite so the value is empty string.
# In production point this at your deployed API server.
VITE_API_ORIGIN=

# Socket.io server origin — usually the same as the API origin.
# Leave empty in development (Vite proxy handles it).
VITE_SOCKET_URL=

# ── App Meta ──────────────────────────────────────────────────────────────────

# App display name (used in document title and meta tags)
VITE_APP_NAME=EventSphere Management

# App version (optional — shown in footer or about page)
VITE_APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────────────
# QUICK START (local development)
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. cp .env.example .env
# 2. Leave VITE_API_ORIGIN and VITE_SOCKET_URL empty —
#    Vite's dev server proxies /api and /socket.io to localhost:5000
# 3. npm run dev
#
# Production deployment:
#   VITE_API_ORIGIN=https://api.eventsphere.io
#   VITE_SOCKET_URL=https://api.eventsphere.io
#
# ─────────────────────────────────────────────────────────────────────────────